# --- Database -------------------------------------------------------------
# Local development uses a plain SQLite file. Production points at Turso — same
# dialect, so nothing about the schema changes; the adapter switches on the URL
# scheme by itself.
DATABASE_URL="file:./market.db"
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN=

# --- Access ---------------------------------------------------------------
# Leave unset locally: no password means no gate, which keeps development
# frictionless. SET THIS BEFORE DEPLOYING. Without it, anyone who finds the URL
# can edit your watchlist and trigger refreshes against the upstream providers
# from your deployment.
#   ACCESS_PASSWORD="$(openssl rand -base64 24)"
# ACCESS_PASSWORD=

# --- Poller ---------------------------------------------------------------
# Seconds between poller ticks. Lower than 60 buys nothing: the quote budget is
# what governs throughput, and the loop is deliberately idle over half of each
# tick.
POLLER_TICK_MS=60000

# How many Yahoo quote calls one tick may spend. At the 1200ms politeness gap
# this is ~24s of network inside a 60s tick. Raising it is how you get rate
# limited; the code floors the gap regardless.
QUOTE_BUDGET_PER_TICK=20

# How many shares one background news sweep may cover. News is on-demand-first
# — 450 RSS queries would be abusive and pointless.
NEWS_BUDGET_PER_RUN=10

# Minutes before a share page refetches its own news on open.
NEWS_TTL_MINUTES=30

# Days of news to keep. The brief asks for at least a week; 30 gives the
# "heaviest news days" comparison something to work with.
NEWS_RETENTION_DAYS=30

# Days of INTRADAY price rows to keep before pruning.
INTRADAY_RETENTION_DAYS=7

# --- Politeness -----------------------------------------------------------
# Per-request timeout. These are free endpoints; a slow answer is normal.
FETCH_TIMEOUT_MS=12000

# Raise the minimum gap between requests to one host. The per-host floors in
# src/lib/providers/rate-limit.ts always win, so this can only slow things
# down — which is the only direction worth allowing.
POLITE_MIN_GAP_MS=0

# --- Derivatives ----------------------------------------------------------
# Comma-separated underlyings whose option chain is captured.
OPTION_UNDERLYINGS=NIFTY

# How many expiries forward to capture. 1 = the current weekly only.
OPTION_EXPIRY_DEPTH=1

# Days of option chain snapshots to keep.
OPTION_RETENTION_DAYS=14
